APP_NAME="استوديو البروفايل"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Riyadh

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# the team's first password (changeable later from the studio's settings page)
STUDIO_PASSWORD=

# the PDF engine: Python with pypdf (engine/requirements.txt) and Chrome/Chromium
STUDIO_PYTHON=python3
CHROME_BIN=chromium
STUDIO_PROFILE_MAX_MB=150

VITE_APP_NAME="${APP_NAME}"
